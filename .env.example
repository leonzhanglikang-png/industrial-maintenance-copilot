APP_NAME=Industrial Maintenance Copilot
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Added in the retrieval stage.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintenance_documents
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# OpenAI-compatible configuration. Never commit a real key.
ANSWER_GENERATOR=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=3
EMBEDDING_MODEL=
