APP_NAME=Industrial Maintenance Copilot
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Parsed chunks survive restarts. This database is local runtime data, not committed.
CHUNK_STORE_PATH=data/processed/documents.sqlite3
# Production requires a random access token of at least 24 characters.
# This is a workbench access token, NOT the model API key.
API_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# Added in the retrieval stage.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintenance_documents
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# extractive = offline, openai = Responses, chat_completions = Chat API.
# Never commit a real key. DeepSeek setup is documented in README.
ANSWER_GENERATOR=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
CHAT_MAX_TOKENS=512
# DeepSeek supports this extension; leave false for unverified compatible providers.
CHAT_DISABLE_THINKING=false
AGENT_MAX_STEPS=3

# Explicit opt-in: openai sends document chunks and queries to this endpoint.
# Keep hash for offline use. Embedding credentials are independent of LLM credentials.
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Expected native output dimension; not a request to shorten the model's vectors.
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30
