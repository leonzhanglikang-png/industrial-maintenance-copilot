server {
    listen 443 ssl;
    server_name 124.221.234.13;
    ssl_certificate /etc/letsencrypt/live/maintenance-copilot/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/maintenance-copilot/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
        proxy_connect_timeout 5s;
    }
}
